          "package": null,
          "import_style": "顶层模块导入：import config / from connectors.openalex import ...",
          "exports": [
            "run_discovery_cycle",
            "search_papers",
            "expand_from_paper",
            "score_papers",
            "record_feedback",
            "get_review_queue",
            "interesting_papers",
            "Store.upsert_paper",
            "Paper.dedup_key",
            "Paper.merge"
          ]
        },
        "cli": {
          "entry": "literature_explorer/literature_explorer/scripts",
          "commands": [
            "python3 scripts/search_topic.py \"<topic>\" [--limit 30] [--db path] [--no-second-wave]",
            "python3 scripts/review_candidates.py [--limit 50] [--db path]",
            "python3 scripts/expand_interesting.py [--limit 30] [--db path]"
          ],
          "behavior": "输出为人读表格，非机器协议；review_candidates 为交互式（i/r/l/s/q）。"
        }
      },
